/explorer

// e2e test-run artifacts, 473 MB
/e2e

// Local simulation output
/sim

// Archives and backups, ~640 MB of test*.tgz and .tar.gz
*.tgz
*.tar.gz
*.zip

// Logs, Go test binaries, noise
*.log
*.test
.DS_Store
Thumbs.db
*.swp
