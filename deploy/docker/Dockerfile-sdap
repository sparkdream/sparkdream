# ActivityPub live-link daemons: sdapbridge (default CMD) and sdapverify.
#
# The launcher runs sdapbridge as a sidecar service next to a Mastodon
# instance. sdapverify ships in the same image but must NOT run beside the
# bridge: the federation spec requires a verifier on a separate account,
# host and network vantage point, so run it elsewhere with
#   docker run ... sparkdreamnft/sdap:<ver> sdapverify
#
# Both daemons are configured purely by env (see cmd/sdapbridge/config.go
# and cmd/sdapverify/main.go). Neither depends on a network build tag, so
# one image serves every network. The bridge's cursor/consent state goes
# to SDA_STATE on the /data volume: it is rebuildable from the chain, but
# consent timestamps and the timeline cursor are not, so mount /data on
# persistent storage.
#
# Signing: on a host you do not control, give the daemons an x/session
# key (SDA_SESSION_KEY_FILE, e.g. /data/session-key, + SDA_GRANTER), never
# the account's mnemonic. The entrypoint (deploy/docker/sdap/sdap-entry.sh)
# starts as root only to hand /data to the unprivileged sdap user, so a
# root-owned volume works; pass the daemon as the command (or as args after
# the entrypoint), not as an entrypoint override.
#
# The build context is allowlisted by Dockerfile-sdap.dockerignore.
#
# Build from the repo root:
#   docker build -f deploy/docker/Dockerfile-sdap -t sparkdreamnft/sdap:<ver> .

FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/sdapbridge ./cmd/sdapbridge \
 && CGO_ENABLED=0 go build -trimpath -o /out/sdapverify ./cmd/sdapverify

FROM alpine
RUN apk add --no-cache ca-certificates su-exec \
 && adduser -D -u 10001 sdap \
 && mkdir -p /data \
 && chown sdap /data
COPY --from=build /out/sdapbridge /out/sdapverify /usr/local/bin/
COPY deploy/docker/sdap/sdap-entry.sh /usr/local/bin/sdap-entry
WORKDIR /data
ENV SDA_STATE=/data/sdapbridge-state.json
ENTRYPOINT ["sdap-entry"]
CMD ["sdapbridge"]
