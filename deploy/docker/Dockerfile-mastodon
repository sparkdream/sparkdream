# Mastodon for the chain launcher's mastodon component: the upstream image
# plus what running it on Akash needs.
#
#   - mastodon-run: web (puma) + sidekiq in one container, since an Akash
#     persistent volume belongs to one service and both write media; takes
#     ownership of that root-owned volume, waits for postgres/redis,
#     `rails db:prepare` (so an image upgrade migrates itself), then drops to
#     uid 991 for everything Mastodon runs
#   - zz_sparkdream_proxy.rb: SPARKDREAM_ASSUME_SSL=true stops the redirect
#     loop force_ssl causes behind an ingress that forwards plain HTTP
#   - zz_sparkdream_wallet_login.rb: wallet sign-in through the sdaplogin
#     sidecar (SPARKDREAM_WALLET_LOGIN=true): the linked-chain list route,
#     handles from x/name, the hourly membership sweep scheduled below, and
#     ending sessions opened through a sign-in grant once the grant is gone
#   - mastodon-bootstrap: idempotent owner account / registrations / bridge
#     token / wallet-login chain setup the launcher runs over lease-shell
#   - backup tools for the launcher's Mastodon backups: pg_dump / pg_restore /
#     psql, age and s5cmd. The database is dumped over the network from the
#     postgres service, encrypted with age to the fleet's key and streamed to
#     S3-compatible storage with s5cmd, as are the uploaded media; a restore
#     reads them back with curl. The client's major version matches the
#     launcher's postgres image (postgres:14-alpine), so a dump restores into
#     the same server version it came from
#
# The streaming server needs none of this and runs the upstream
# ghcr.io/mastodon/mastodon-streaming image as-is.
#
# Build from the repo root:
#   make docker-build-mastodon VERSION=<chain version>

ARG MASTODON_IMAGE=ghcr.io/mastodon/mastodon:v4.7.2
FROM ${MASTODON_IMAGE}

ARG S5CMD_VERSION=2.2.2
ARG PG_CLIENT_MAJOR=14

USER root
RUN set -eux; \
    . /etc/os-release; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates age; \
    install -d /usr/share/postgresql-common/pgdg; \
    curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc; \
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends "postgresql-client-${PG_CLIENT_MAJOR}"; \
    curl -fsSL -o /tmp/s5cmd.tar.gz "https://github.com/peak/s5cmd/releases/download/v${S5CMD_VERSION}/s5cmd_${S5CMD_VERSION}_Linux-64bit.tar.gz"; \
    tar -xzf /tmp/s5cmd.tar.gz -C /usr/local/bin s5cmd; \
    rm -rf /tmp/s5cmd.tar.gz /var/lib/apt/lists/*; \
    pg_dump --version; \
    age --version; \
    s5cmd version
COPY deploy/docker/mastodon/zz_sparkdream_proxy.rb /opt/mastodon/config/initializers/zz_sparkdream_proxy.rb
COPY deploy/docker/mastodon/zz_sparkdream_wallet_login.rb /opt/mastodon/config/initializers/zz_sparkdream_wallet_login.rb
COPY deploy/docker/mastodon/mastodon-run.sh /usr/local/bin/mastodon-run
COPY deploy/docker/mastodon/mastodon-bootstrap.sh /usr/local/bin/mastodon-bootstrap
RUN chmod 0755 /usr/local/bin/mastodon-run /usr/local/bin/mastodon-bootstrap \
 && chmod 0644 /opt/mastodon/config/initializers/zz_sparkdream_proxy.rb \
               /opt/mastodon/config/initializers/zz_sparkdream_wallet_login.rb
# the wallet-login sweeps in sidekiq's scheduler: membership hourly, delegated
# sessions every 10 minutes (both workers return at once unless
# SPARKDREAM_WALLET_LOGIN=true)
COPY deploy/docker/mastodon/sidekiq-sparkdream.yml /tmp/sidekiq-sparkdream.yml
RUN sed -i '/^  :schedule:$/r /tmp/sidekiq-sparkdream.yml' config/sidekiq.yml \
 && grep -q '^      class: SparkdreamMembershipSweepWorker$' config/sidekiq.yml \
 && grep -q '^      class: SparkdreamDelegatedSessionSweepWorker$' config/sidekiq.yml \
 && rm /tmp/sidekiq-sparkdream.yml

# root, so mastodon-run can take the volume; it drops to 991 itself
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["mastodon-run"]
